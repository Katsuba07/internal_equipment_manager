# Environment configuration template.
# Copy this file to .env and adjust the values.
# The real .env must never be shared or committed.

# Secret key — generate a fresh one for every installation:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
EMA_SECRET_KEY=replace-with-your-own-random-key

# Debug mode. MUST be False in real use: True exposes configuration details
# to users whenever an error occurs.
EMA_DEBUG=False

# Hostnames allowed to reach the app, comma separated.
# "*" is fine on a closed LAN. When exposing it to the internet, name the host:
#   EMA_ALLOWED_HOSTS=ema.company.com
EMA_ALLOWED_HOSTS=*

# Time zone used for dates and due-date calculations.
EMA_TIME_ZONE=Asia/Ho_Chi_Minh

# Only needed when served over HTTPS (Cloudflare Tunnel, own domain).
# EMA_CSRF_TRUSTED_ORIGINS=https://ema.company.com
# EMA_BEHIND_HTTPS_PROXY=True

# Maximum size per uploaded attachment, in MB.
EMA_MAX_UPLOAD_MB=20

# Folder holding the database and uploads.
# Leave unset to use the project's data/ folder.
# IMPORTANT: must be a local disk on the server, NEVER a network share.
# EMA_DATA_DIR=D:\EMA\data

# Where scripts\backup.ps1 writes backups when no -Destination is given.
# A network share keeps them off the server's own disk.
# EMA_BACKUP_DIR=\\fileserver\Backup\EMA

# Product documents: the TE folder on SharePoint, synced to this server by
# OneDrive (sign in with the company account, open the folder on SharePoint,
# press Sync). Point this at the synced folder. Without it, the document
# links still open SharePoint, but new files on SharePoint are not listed.
# EMA_DOCS_ROOT=C:\Users\<you>\Computime Holdings Limited\CTV - Documents\CTV3\MP lines Prepare Setup CTVN CTV3\TE
# The same folder as SharePoint sees it (defaults shown):
# EMA_DOCS_SHAREPOINT_SITE=https://computimehk.sharepoint.com
# EMA_DOCS_SHAREPOINT_FOLDER=/sites/CTV/Shared Documents/CTV3/MP lines Prepare Setup CTVN CTV3/TE

